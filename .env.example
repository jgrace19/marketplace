# Stripe test keys
STRIPE_SECRET_KEY=sk_test_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Datadog
# Get an API key at https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=
# Your Datadog site: datadoghq.com (US1), us3.datadoghq.com, us5.datadoghq.com,
# datadoghq.eu (EU), ap1.datadoghq.com, ddog-gov.com
DD_SITE=datadoghq.com
# Optional but required for Logs API validation in start-docker-local skill
# DD_APP_KEY=

# Optional overrides for Docker Compose
# Native local keeps 8000 (API) + 5173 (Vite). Docker uses 8001 + 8081.
# FRONTEND_URL=http://localhost:8081
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# VITE_API_BASE=http://127.0.0.1:8001
